{
  "name": "agent-office",
  "version": "0.1.0",
  "description": "An office where your team runs Claude Code workers on its projects, shares live terminals, and tracks GitHub issues and PRs: a board view per project and a pixel-art office from above.",
  "type": "module",
  "bin": {
    "agent-office": "bin/agent-office.js"
  },
  "imports": {
    "#tests/css": "./tests/support/css.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:one": "node --import tsx --import=#tests/css --test",
    "test:perf": "npm run build && node scripts/perf/suite.mjs",
    "test:perf:quick": "npm run build && node scripts/perf/suite.mjs --quick",
    "dev": "concurrently -k \"vite\" \"tsx watch src/server/cli.ts --port 4600 --password dev --no-open\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node bin/agent-office.js",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "mermaid": "11.17.2",
    "playwright-core": "1.63.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
