{
  "color": {
    "$type": "color",
    "base": {
      "teal": { "$value": "#00796b" },
      "white": { "$value": "#ffffff" }
    },
    "brand": {
      "primary": { "$value": "{color.base.teal}" }
    },
    "background": { "$value": "#f1f5f4" },
    "surface": { "$value": "{color.base.white}" },
    "text": { "$value": "#102a27" },
    "success": { "$value": "#2e7d32" },
    "warning": { "$value": "#f9a825" },
    "danger": { "$value": "#c62828" },
    "info": { "$value": "#0277bd" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Source Sans 3", "Arial", "sans-serif"] }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "2px" }
  }
}
