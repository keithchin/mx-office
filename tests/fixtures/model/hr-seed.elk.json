  "mdlSource": "create or modify microflow HR.ASu_SeedBaseline ()\nreturns Boolean\nbegin\n  @position(360, 200)\n  retrieve $Existing from HR.Employee\n    first;\n  @position(520, 200)\n  if $Existing != empty then\n    @position(690, 300)\n    return true;\n  end if;\n  @position(690, 200)\n  retrieve $UMaria from System.User\n    where Name = 'mgr.maria'\n    first;\n  @position(850, 200)\n  retrieve $UMark from System.User\n    where Name = 'mgr.mark'\n    first;\n  @position(1010, 200)\n  retrieve $UAlice from System.User\n    where Name = 'emp.alice'\n    first;\n  @position(1170, 200)\n  retrieve $UBob from System.User\n    where Name = 'emp.bob'\n    first;\n  @position(1330, 200)\n  retrieve $UCarol from System.User\n    where Name = 'emp.carol'\n    first;\n  @position(1490, 200)\n  retrieve $UAda from System.User\n    where Name = 'admin.ada'\n    first;\n  @position(1650, 200)\n  $Maria = create HR.Employee (EmployeeNumber = 'M001', FullName = 'Maria Manager', Email = 'maria@example.test', Employee_User = $UMaria) commit;\n  @position(1810, 200)\n  $Mark = create HR.Employee (EmployeeNumber = 'M002', FullName = 'Mark Manager', Email = 'mark@example.test', Employee_User = $UMark) commit;\n  @position(1970, 200)\n  $Alice = create HR.Employee (EmployeeNumber = 'E001', FullName = 'Alice Employee', Email = 'alice@example.test', Employee_User = $UAlice, Employee_Manager = $Maria) commit;\n  @position(2130, 200)\n  $Bob = create HR.Employee (EmployeeNumber = 'E002', FullName = 'Bob Employee', Email = 'bob@example.test', Employee_User = $UBob, Employee_Manager = $Maria) commit;\n  @position(2290, 200)\n  $Carol = create HR.Employee (EmployeeNumber = 'E003', FullName = 'Carol Employee', Email = 'carol@example.test', Employee_User = $UCarol, Employee_Manager = $Mark) commit;\n  @position(2450, 200)\n  $Ada = create HR.Employee (EmployeeNumber = 'A001', FullName = 'Ada Admin', Email = 'ada@example.test', Employee_User = $UAda) commit;\n  @position(2610, 200)\n  $Welcome = create Notices.Notice (Title = 'Welcome to the company portal', Body = 'Baseline notice used by the regression checks.', PublishedOn = [%CurrentDateTime%]) commit;\n  @position(2770, 200)\n  log node 'Baseline' 'Seeded 6 employees and 1 notice';\n  @position(2930, 200)\n  return true;\nend;",
