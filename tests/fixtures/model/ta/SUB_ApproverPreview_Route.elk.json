ep3","Preview = $Preview","OriginName = $OriginName","DestinationName = $DestinationName"],"width":414,"height":108},{"id":"node-6ddedb5c-dc7f-403f-a552-ec9215f546ea","type":"action","category":"variable","label":"List Operation","details":["Output: $Step4"],"width":129,"height":44},{"id":"node-2c8a5754-6701-46f8-9549-f1c0f82f21f2","type":"action","category":"call","label":"Call TravelApproval.SUB_Approver...","details":["Microflow: TravelApproval.SUB_ApproverPreview_AddRow","Step = $Step4","Preview = $Preview","OriginName = $OriginName","DestinationName = $DestinationName"],"width":414,"height":108},{"id":"node-958d8c5b-4bfd-47d3-9cf6-c3edd0d1517a","type":"end","category":"event","label":"End","width":70.5,"height":36},{"id":"node-ab05aa98-1c5a-43de-ada1-7ae351cff7cd","type":"action","category":"variable","label":"declare $Hint","details":["Variable: $Hint","Value: if $HasDestination then 'Not needed: a trip inside your c..."],"width":527,"height":60},{"id":"node-dd1ff2ef-e9c2-4325-a920-73fbfe0b2bf7","type":"action","category":"object","label":"Create TravelApproval.ApproverPreview","details":["Entity: TravelApproval.ApproverPreview","Output: $RestRow","Sequence = 2","Label = 'Country Head, Regional Manager, CFO'","ApproverName = empty","Note = $Hint","IsSkipped = true"],"width":362,"height":140},{"id":"node-d0d51ae3-34c0-45b2-886e-bb24c905103f","type":"action","category":"variable","label":"Action","width":100,"height":36},{"id":"node-cc18f223-594b-4625-a4ee-7a6e7db259c2","type":"end","category":"event","label":"End","width":70.5,"height":36}],"edges":[{"id":"edge-0","sourceId":"node-1e777465-0059-4695-b575-48121c54b9c6","targetId":"node-16bc8b90-3e09-4dfd-b59e-7be021faee92"},{"id":"edge-1","sourceId":"node-16bc8b90-3e09-4dfd-b59e-7be021faee92","targetId":"node-6f49db07-50d3-4b44-b4c2-9bb35e2abeb0"},{"id":"edge-2","sourceId":"node-6f49db07-50d3-4b44-b4c2-9bb35e2abeb0","targetId":"node-4a0e824d-a85b-4b1b-8fb7-6e33efcd4bb8"},{"id":"edge-3","sourceId":"node-4a0e824d-a85b-4b1b-8fb7-6e33efcd4bb8","targetId":"node-f79013fd-9f3e-4444-a002-b359a7821b64"},{"id":"edge-4","sourceId":"node-f79013fd-9f3e-4444-a002-b359a7821b64","targetId":"node-18d81869-e9ff-4100-b4d5-c1bd353bb2b8"},{"id":"edge-5","sourceId":"node-18d81869-e9ff-4100-b4d5-c1bd353bb2b8","targetId":"node-0dbfb389-b81e-4732-8851-0d562aed30ab"},{"id":"edge-6","sourceId":"node-065c600e-cdad-4111-8ac1-5b123c6c800e","targetId":"node-860c3ad7-e331-4a93-9a9d-d0c27c411168","label":"true"},{"id":"edge-7","sourceId":"node-860c3ad7-e331-4a93-9a9d-d0c27c411168","targetId":"node-dcdd51cc-27d5-4721-bf74-1f3f70c6564f"},{"id":"edge-8","sourceId":"node-dcdd51cc-27d5-4721-bf74-1f3f70c6564f","targetId":"node-22d8f2c0-1b96-4fee-b5ae-344d44c66022"},{"id":"edge-9","sourceId":"node-22d8f2c0-1b96-4fee-b5ae-344d44c66022","targetId":"node-0b52d8e1-84c6-40ae-b505-14fd6bc8e63f"},{"id":"edge-10","sourceId":"node-0b52d8e1-84c6-40ae-b505-14fd6bc8e63f","targetId":"node-f4a66c7c-cb7d-4e09-9c61-e2231c5bc28a"},{"id":"edge-11","sourceId":"node-f4a66c7c-cb7d-4e09-9c61-e2231c5bc28a","targetId":"node-d6d41b8a-a5d0-4be4-953a-05ca558da634"},{"id":"edge-12","sourceId":"node-d6d41b8a-a5d0-4be4-953a-05ca558da634","targetId":"node-3bddf6e4-047f-489a-8e82-eb6010869905"},{"id":"edge-13","sourceId":"node-3bddf6e4-047f-489a-8e82-eb6010869905","targetId":"node-6ddedb5c-dc7f-403f-a552-ec9215f546ea"},{"id":"edge-14","sourceId":"node-6ddedb5c-dc7f-403f-a552-ec9215f546ea","targetId":"node-2c8a5754-6701-46f8-9549-f1c0f82f21f2"},{"id":"edge-15","sourceId":"node-2c8a5754-6701-46f8-9549-f1c0f82f21f2","targetId":"node-958d8c5b-4bfd-47d3-9cf6-c3edd0d1517a"},{"id":"edge-16","sourceId":"node-0dbfb389-b81e-4732-8851-0d562aed30ab","targetId":"node-065c600e-cdad-4111-8ac1-5b123c6c800e"},{"id":"edge-17","sourceId":"node-065c600e-cdad-4111-8ac1-5b123c6c800e","targetId":"node-ab05aa98-1c5a-43de-ada1-7ae351cff7cd","label":"false"},{"id":"edge-18","sourceId":"node-ab05aa98-1c5a-43de-ada1-7ae351cff7cd","targetId":"node-dd1ff2ef-e9c2-4325-a920-73fbfe0b2bf7"},{"id":"edge-19","sourceId":"node-dd1ff2ef-e9c2-4325-a920-73fbfe0b2bf7","targetId":"node-d0d51ae3-34c0-45b2-886e-bb24c905103f"},{"id":"edge-20","sourceId":"node-d0d51ae3-34c0-45b2-886e-bb24c905103f","targetId":"node-cc18f223-594b-4625-a4ee-7a6e7db259c2"}],"mdlSource":"/**\n * The dry-run route for a non-exempt requestor: the SAME SUB_TravelRequest_AddStep calls as SUB_TravelRequest_BuildRoute (Manager always; Country Head, Regional Manager, CFO when escalated), into in-memory lists that are never committed, then one preview row per step. A domestic trip gets one \"Not needed\" line; a request with no destination yet gets a hint instead.\n */\ncreate or modify microflow TravelApproval.SUB_ApproverPreview_Route (\n  $TravelRequest: TravelApproval.TravelRequest,\n  $Requestor: TravelApproval.TravelProfile,\n  $Escalated: Boolean,\n  $HasDestination: Boolean,\n  $OriginName: String,\n  $DestinationName: String,\n  $Preview: List of TravelApproval.ApproverPreview\n)\nbegin\n  @position(360, 200)\n  $Taken = create list of TravelApproval.TravelProfile;\n  @position(520, 200)\n  add $Requestor to $Taken;\n  @position(680, 200)\n  $Steps = create list of TravelApproval.ApprovalStep;\n  @position(840, 200)\n  call microflow TravelApproval.SUB_TravelRequest_AddStep(TravelRequest = $TravelRequest, Requestor = $Requestor, Level = TravelApproval.ENUM_ApprovalLevel.Manager, Sequence = 1, Taken = $Taken, Steps = $Steps);\n  @position(1000, 200)\n  $Step1 = find($Steps, Sequence = 1);\n  @position(1160, 200)\n  call microflow TravelApproval.SUB_ApproverPreview_AddRow(Step = $Step1, Preview = $Preview, OriginName = $OriginName, DestinationName = $DestinationName);\n  @position(1320, 200)\n  @caption '$Escalated'\n  if $Escalated then\n    @position(1490, 300)\n    call microflow TravelApproval.SUB_TravelRequest_AddStep(TravelRequest = $TravelRequest, Requestor = $Requestor, Level = TravelApproval.ENUM_ApprovalLevel.CountryHead, Sequence = 2, Taken = $Taken, Steps = $Steps);\n    @position(1650, 300)\n    call microflow TravelApproval.SUB_TravelRequest_AddStep(TravelRequest = $TravelRequest, Requestor = $Requestor, Level = TravelApproval.ENUM_ApprovalLevel.RegionalManager, Sequence = 3, Taken = $Taken, Steps = $Steps);\n    @position(1810, 300)\n    call microflow TravelApproval.SUB_TravelRequest_AddStep(TravelRequest = $TravelRequest, Requestor = $Requestor, Level = TravelApproval.ENUM_ApprovalLevel.CFO, Sequence = 4, Taken = $Taken, Steps = $Steps);\n    @position(1970, 300)\n    $Step2 = find($Steps, Sequence = 2);\n    @position(2130, 300)\n    call microflow TravelApproval.SUB_ApproverPreview_AddRow(Step = $Step2, Preview = $Preview, OriginName = $OriginName, DestinationName = $DestinationName);\n    @position(2290, 300)\n    $Step3 = find($Steps, Sequence = 3);\n    @position(2450, 300)\n    call microflow TravelApproval.SUB_ApproverPreview_AddRow(Step = $Step3, Preview = $Preview, OriginName = $OriginName, DestinationName = $DestinationName);\n    @position(2610, 300)\n    $Step4 = find($Steps, Sequence = 4);\n    @position(2770, 300)\n    call microflow TravelApproval.SUB_ApproverPreview_AddRow(Step = $Step4, Preview = $Preview, OriginName = $OriginName, DestinationName = $DestinationName);\n    @position(2930, 300)\n    return;\n  end if;\n  @position(1490, 200)\n  declare $Hint String = if $HasDestination then 'Not needed: a trip inside your country of residence stops at your manager.' else 'Choose the destination country. A trip outside your country of residence adds these three approvers.';\n  @position(1650, 200)\n  $RestRow = create TravelApproval.ApproverPreview (Sequence = 2, Label = 'Country Head, Regional Manager, CFO', ApproverName = empty, Note = $Hint, IsSkipped = true);\n  @position(1810, 200)\n  add $RestRow to $Preview;\n  @position(2050, 200)\n  return;\nend;\n/","sourceMap":{"node-065c600e-cdad-4111-8ac1-5b123c6c800e":{"startLine":25,"endLine":48},"node-0b52d8e1-84c6-40ae-b505-14fd6bc8e63f":{"startLine":3