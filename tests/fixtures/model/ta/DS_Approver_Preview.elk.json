60226"},{"id":"edge-8","sourceId":"node-b914cc87-b009-4ae4-b49a-736055acd30a","targetId":"node-24a859df-1563-4523-b81e-e4823fcb403d","label":"true"},{"id":"edge-9","sourceId":"node-24a859df-1563-4523-b81e-e4823fcb403d","targetId":"node-67c3de29-6549-4f7b-b7b9-a90e5565bea9"},{"id":"edge-10","sourceId":"node-67c3de29-6549-4f7b-b7b9-a90e5565bea9","targetId":"node-3597242d-9f1f-494b-9271-d8d56859a08c"},{"id":"edge-11","sourceId":"node-c23c0bc6-058d-4d28-ae92-a4e441860226","targetId":"node-b914cc87-b009-4ae4-b49a-736055acd30a","label":"false"},{"id":"edge-12","sourceId":"node-b914cc87-b009-4ae4-b49a-736055acd30a","targetId":"node-66b88594-363e-4945-b81a-7692341a159d","label":"false"},{"id":"edge-13","sourceId":"node-66b88594-363e-4945-b81a-7692341a159d","targetId":"node-1c66fa39-d55d-45e8-983a-939170612cdd"},{"id":"edge-14","sourceId":"node-1c66fa39-d55d-45e8-983a-939170612cdd","targetId":"node-c5cb089c-f2e8-4a19-947d-11c9e1dbe0e5"},{"id":"edge-15","sourceId":"node-a8eb5a4c-3fab-4212-a202-c21fb488c600","targetId":"node-e3745acf-5487-4a41-840d-7e14aaa656e6","label":"false"},{"id":"edge-16","sourceId":"node-a8eb5a4c-3fab-4212-a202-c21fb488c600","targetId":"node-c2154b7a-7026-4b05-84ff-b3db777cf014","label":"true"},{"id":"edge-17","sourceId":"node-c2154b7a-7026-4b05-84ff-b3db777cf014","targetId":"node-e3745acf-5487-4a41-840d-7e14aaa656e6"},{"id":"edge-18","sourceId":"node-c5cb089c-f2e8-4a19-947d-11c9e1dbe0e5","targetId":"node-a8eb5a4c-3fab-4212-a202-c21fb488c600"},{"id":"edge-19","sourceId":"node-e3745acf-5487-4a41-840d-7e14aaa656e6","targetId":"node-a57c41f0-f21b-40e5-a6a3-2c0d80b5b28c"},{"id":"edge-20","sourceId":"node-a57c41f0-f21b-40e5-a6a3-2c0d80b5b28c","targetId":"node-7bab41de-47cb-4bec-9420-381793e750bb"}],"mdlSource":"/**\n * Data source of the approver preview on Request_NewEdit / SNIP_Request_Form (F001 p-approvers; BR001, BR005, BR010, BR011, BR012). A dry run of the submit route that commits nothing and does not change the request. Empty for anyone but the requestor. Exempt requestor: one line saying the request is approved on submit. Otherwise SUB_ApproverPreview_Route, with escalation by SUB_TravelRequest_Derive's rule (destination code differs from origin code). Runs without entity access: Requestors cannot read Responsibility.\n */\ncreate or modify microflow TravelApproval.DS_Approver_Preview (\n  $TravelRequest: TravelApproval.TravelRequest\n)\nreturns List of TravelApproval.ApproverPreview as $Preview\nbegin\n  @position(360, 200)\n  $Preview = create list of TravelApproval.ApproverPreview;\n  @position(520, 200)\n  declare $LoginName String = if $currentUser = empty then '' else $currentUser/Name;\n  @position(680, 200)\n  retrieve $Requestor from $TravelRequest/TravelApproval.TravelRequest_Requestor;\n  @position(840, 200)\n  @caption '$Requestor = empty'\n  if $Requestor = empty then\n    @position(1010, 300)\n    return $Preview;\n  end if;\n  @position(1010, 200)\n  retrieve $RequestorAccount from $Requestor/TravelApproval.TravelProfile_Account;\n  @position(1170, 200)\n  @caption '$RequestorAccount = empty or $RequestorAccount/Name != $LoginName'\n  if $RequestorAccount = empty or $RequestorAccount/Name != $LoginName then\n    @position(1340, 300)\n    return $Preview;\n  end if;\n  @position(1435, 200)\n  @caption '$Requestor/IsExempt'\n  if $Requestor/IsExempt then\n    @position(1605, 300)\n    $ExemptRow = create TravelApproval.ApproverPreview (Sequence = 0, Label = 'No approvers', ApproverName = empty, Note = 'You are exempt from the approval chain: the request is approved when you submit it.', IsSkipped = true);\n    @position(1765, 300)\n    add $ExemptRow to $Preview;\n    @position(1925, 300)\n    return $Preview;\n  end if;\n  @position(1605, 200)\n  retrieve $Origin from $TravelRequest/TravelApproval.TravelRequest_OriginCountry;\n  @position(1765, 200)\n  retrieve $Destination from $TravelRequest/TravelApproval.TravelRequest_DestinationCountry;\n  @position(1925, 200)\n  declare $Escalated Boolean = false;\n  @position(2085, 200)\n  @merge(2375, 200)\n  @caption '$Origin != empty and $Destination != empty'\n  if $Origin != empty and $Destination != empty then\n    @position(2255, 300)\n    set $Escalated = $Destination/Code != $Origin/Code;\n  end if;\n  @position(2495, 200)\n  call microflow TravelApproval.SUB_ApproverPreview_Route(TravelRequest = $TravelRequest, Requestor = $Requestor, Escalated = $Escalated, HasDestination = $Destination != empty, OriginName = if $Origin = empty then 'your country of residence' else $Origin/Name, DestinationName = if $Destination = empty then 'the destination country' else $Destination/Name, Preview = $Preview);\n  @position(2655, 200)\n  return $Preview;\nend;\n\ngrant execute on microflow TravelApproval.DS_Approver_Preview to TravelApproval.Requestor;\n/","sourceMap":{"node-0a0481b8-aab6-4f4e-82a4-d0f22fb2c1ae":{"startLine":17,"endLine":18},"node-1c66fa39-d55d-45e8-983a-939170612cdd":{"startLine":40,"endLine":41},"node-24a859df-1563-4523-b81e-e4823fcb403d":{"startLine":31,"endLine":32},"node-261faa76-5eac-44f6-bcbb-59bf75ce2046":{"startLine":12,"endLine":13},"node-3244a25b-1171-41a2-af48-7b44bdf9b3fc":{"startLine":25,"endLine":26},"node-3597242d-9f1f-494b-9271-d8d56859a08c":{"startLine":35,"endLine":36},"node-66b88594-363e-4945-b81a-7692341a159d":{"startLine":38,"endLine":39},"node-67c3de29-6549-4f7b-b7b9-a90e5565bea9":{"startLine":33,"endLine":34},"node-7bab41de-47cb-4bec-9420-381793e750bb":{"startLine":53,"endLine":54},"node-83837db7-279a-4acf-9aa8-0e1b3584c66a":{"startLine":8,"endLine":9},"node-927868a8-b516-4a05-a423-2022d445c134":{"startLine":10,"endLine":11},"node-a57c41f0-f21b-40e5-a6a3-2c0d80b5b28c":{"startLine":51,"endLine":52},"node-a8eb5a4c-3fab-4212-a202-c21fb488c600":{"startLine":44,"endLine":50},"node-b914cc87-b009-4ae4-b49a-736055acd30a":{"startLine":28,"endLine":37},"node-c2154b7a-7026-4b05-84ff-b3db777cf014":{"startLine":48,"endLine":49},"node-c23c0bc6-058d-4d28-ae92-a4e441860226":{"startLine":22,"endLine":27},"node-c5cb089c-f2e8-4a19-947d-11c9e1dbe0e5":{"startLine":42,"endLine":43},"node-e4dbc31f-c9fa-472b-b9b9-d125e720bbbf":{"startLine":20,"endLine":21},"node-ed5cdd81-e7df-48d0-886b-e8531538d8e3":{"startLine":14,"endLine":19}}}