a6-6117-4c66-87fa-0899b5441483","targetId":"node-2caf325c-ec98-4b12-b897-39f370fe529a"},{"id":"edge-12","sourceId":"node-2caf325c-ec98-4b12-b897-39f370fe529a","targetId":"node-c4e3613c-f730-4556-8043-bba765ef9a8f"},{"id":"edge-13","sourceId":"node-d78fd2c4-6b1e-499a-b7f1-6bdd6057134b","targetId":"node-0d2d85c7-1b2a-4305-896e-044113d20454"},{"id":"edge-14","sourceId":"node-0d2d85c7-1b2a-4305-896e-044113d20454","targetId":"node-f261ecaf-414d-4044-8c27-84c855b78a0e"},{"id":"edge-15","sourceId":"node-ca8bccc7-4ac9-4556-9da1-fe2fbd884f0f","targetId":"node-34f3f3cc-b448-4664-8cff-a1f5ef546ce5"},{"id":"edge-16","sourceId":"node-f261ecaf-414d-4044-8c27-84c855b78a0e","targetId":"node-da5ac524-7900-491a-98b5-4cab94473c09"},{"id":"edge-17","sourceId":"node-c4e3613c-f730-4556-8043-bba765ef9a8f","targetId":"node-d78fd2c4-6b1e-499a-b7f1-6bdd6057134b"}],"mdlSource":"/**\n * Outcome Approve (UC003, UC006). Refused when the request is not PendingApproval or no step is open. Marks the open step Approved with DecidedOn, activates the next Pending step (ActivatedOn) if any, writes the Approved event, and notifies the next approver. The last approval leaves the request status to ACT_TravelRequest_CloseApproved.\n */\ncreate or modify microflow TravelApproval.ACT_ApprovalStep_Approve (\n  $WorkflowContext: TravelApproval.TravelRequest\n)\nexposed as workflow action 'Approve step' in 'Travel approval'\nbegin\n  @position(360, 200)\n  $Step = call microflow TravelApproval.SUB_ApprovalStep_FindOpen(TravelRequest = $WorkflowContext);\n  @position(520, 200)\n  @caption '$Step = empty or $WorkflowContext/Status != TravelApproval.ENUM_RequestStatus.PendingApproval'\n  if $Step = empty or $WorkflowContext/Status != TravelApproval.ENUM_RequestStatus.PendingApproval then\n    @position(690, 300)\n    log warning node 'TravelApproval' 'Approve refused for request {1}: no open step, or the request is not pending approval' with ({1} = $WorkflowContext/RequestNumber);\n    @position(850, 300)\n    return;\n  end if;\n  @position(690, 200)\n  change $Step (Decision = TravelApproval.ENUM_StepDecision.Approved, DecidedOn = [%CurrentDateTime%]);\n  @position(850, 200)\n  commit $Step;\n  @position(1010, 200)\n  retrieve $Actor from $Step/TravelApproval.ApprovalStep_Approver;\n  @position(1170, 200)\n  call microflow TravelApproval.SUB_RequestEvent_Write(TravelRequest = $WorkflowContext, Actor = $Actor, EventType = TravelApproval.ENUM_EventType.Approved, Decision = TravelApproval.ENUM_StepDecision.Approved, Comment = $Step/Comment, FromStatus = $WorkflowContext/Status, ToStatus = $WorkflowContext/Status);\n  @position(1330, 200)\n  $NextStep = call microflow TravelApproval.SUB_ApprovalStep_FindOpen(TravelRequest = $WorkflowContext);\n  @position(1490, 200)\n  @merge(2420, 200)\n  @caption '$NextStep != empty'\n  if $NextStep != empty then\n    @position(1660, 300)\n    change $NextStep (ActivatedOn = [%CurrentDateTime%]);\n    @position(1820, 300)\n    @curve(to: (-15, 0))\n    commit $NextStep;\n    @position(1980, 300)\n    @curve(from: (15, 0))\n    call microflow TravelApproval.SUB_TravelRequest_SyncCurrentStep(TravelRequest = $WorkflowContext);\n    @position(2140, 300)\n    retrieve $NextApprover from $NextStep/TravelApproval.ApprovalStep_Approver;\n    @position(2300, 300)\n    $Notified = call microflow TravelApproval.SUB_Notification_Send(TravelRequest = $WorkflowContext, Recipient = $NextApprover, EventType = TravelApproval.ENUM_EventType.Submitted);\n  end if;\n  @position(2620, 200)\n  return;\nend;\n\ngrant execute on microflow TravelApproval.ACT_ApprovalStep_Approve to TravelApproval.Approver;\n/","sourceMap":{"node-08ded547-86d4-4a93-a49d-1af827a93998":{"startLine":22,"endLine":23},"node-0d2d85c7-1b2a-4305-896e-044113d20454":{"startLine":42,"endLine":43},"node-0d9813b5-89a1-44b4-a628-29da317b7688":{"startLine":8,"endLine":9},"node-2caf325c-ec98-4b12-b897-39f370fe529a":{"startLine":34,"endLine":36},"node-2f554299-b85e-4ca1-b676-35a34cc70563":{"startLine":24,"endLine":25},"node-34f3f3cc-b448-4664-8cff-a1f5ef546ce5":{"startLine":28,"endLine":44},"node-43d04746-2c08-4b96-b78c-14dc375c6fe1":{"startLine":13,"endLine":14},"node-4bd583a6-6117-4c66-87fa-0899b5441483":{"startLine":32,"endLine":33},"node-8204397c-8c85-4d3b-9dbe-b0a77ac7496e":{"startLine":18,"endLine":19},"node-97b9941e-7794-4194-96dc-4cf559a2a142":{"startLine":15,"endLine":16},"node-b104e29c-1f0a-4c81-881a-05276f664c9e":{"startLine":20,"endLine":21},"node-c4e3613c-f730-4556-8043-bba765ef9a8f":{"startLine":37,"endLine":39},"node-ca8bccc7-4ac9-4556-9da1-fe2fbd884f0f":{"startLine":26,"endLine":27},"node-d78fd2c4-6b1e-499a-b7f1-6bdd6057134b":{"startLine":40,"endLine":41},"node-da5ac524-7900-491a-98b5-4cab94473c09":{"startLine":45,"endLine":46},"node-fca64668-1d48-42c8-bbbf-c0fed182722b":{"startLine":10,"endLine":17}}}