bcfc-93ea9b149efa","targetId":"node-461ddf73-f058-4730-8c8a-521f6357c8b0"},{"id":"edge-19","sourceId":"node-1e8ef59b-fafc-4285-8c4b-b49e86b770e2","targetId":"node-fcbbc1c9-2b67-4aa6-b32a-9979b572b6f7","label":"true"},{"id":"edge-20","sourceId":"node-fcbbc1c9-2b67-4aa6-b32a-9979b572b6f7","targetId":"node-e407c041-f7b9-4d64-9571-6efe4ba3834a"},{"id":"edge-21","sourceId":"node-1e8ef59b-fafc-4285-8c4b-b49e86b770e2","targetId":"node-3dc71b94-ebd3-4612-a1a7-b151341f6b50","label":"false"},{"id":"edge-22","sourceId":"node-3dc71b94-ebd3-4612-a1a7-b151341f6b50","targetId":"node-e407c041-f7b9-4d64-9571-6efe4ba3834a"},{"id":"edge-23","sourceId":"node-461ddf73-f058-4730-8c8a-521f6357c8b0","targetId":"node-1e8ef59b-fafc-4285-8c4b-b49e86b770e2"},{"id":"edge-24","sourceId":"node-e407c041-f7b9-4d64-9571-6efe4ba3834a","targetId":"node-f1849d94-79dd-4afa-ba5b-e62fa84f6324"},{"id":"edge-25","sourceId":"node-f1849d94-79dd-4afa-ba5b-e62fa84f6324","targetId":"node-884a170a-2762-48da-9142-9a73cf53cf81"},{"id":"edge-26","sourceId":"node-884a170a-2762-48da-9142-9a73cf53cf81","targetId":"node-e419ffdc-40c0-4f10-bbd0-6df30662bb2b"}],"mdlSource":"/**\n * Confirm button of Request_Decision (UC004 Return, UC005 Reject; BR006, BR007). THE PAGE-SIDE GUARD: refuses an empty comment or reason with validation feedback and leaves the popup open; nothing is written and the task stays open. Otherwise writes the text to the open step's Comment (what ACT_ApprovalStep_Return / _Reject require), claims the task for the signed-in user, sets the outcome Return or Reject, closes the popup and goes to the approvals list. A request that is no longer pending (decided in another tab) is refused with a message. Runs without entity access: the Approver role cannot write ApprovalStep.\n */\ncreate or modify microflow TravelApproval.ACT_Decision_Confirm (\n  $Task: System.WorkflowUserTask,\n  $WorkflowContext: TravelApproval.TravelRequest,\n  $DecisionDraft: TravelApproval.DecisionDraft\n)\nbegin\n  @position(360, 200)\n  @caption '$DecisionDraft/Text = empty or trim($DecisionDraft/Text) = '''''\n  if $DecisionDraft/Text = empty or trim($DecisionDraft/Text) = '' then\n    @position(530, 350)\n    @merge(820, 350)\n    @caption '$DecisionDraft/Mode = TravelApproval.ENUM_DecisionMode.RejectRequest'\n    if $DecisionDraft/Mode = TravelApproval.ENUM_DecisionMode.RejectRequest then\n      @position(700, 350)\n      validation feedback $DecisionDraft/Text message 'Write the reason. The requestor sees it.';\n    else\n      @position(700, 450)\n      validation feedback $DecisionDraft/Text message 'Write a comment so the requestor knows what to change.';\n    end if;\n    @position(940, 350)\n    return;\n  else\n    @position(995, 200)\n    @caption '$DecisionDraft/Mode = empty'\n    if $DecisionDraft/Mode = empty then\n      @position(1165, 300)\n      show message 'Choose Return or Reject first.' type Warning;\n      @position(1325, 300)\n      return;\n    end if;\n    @position(1165, 200)\n    $Step = call microflow TravelApproval.SUB_ApprovalStep_FindOpen(TravelRequest = $WorkflowContext);\n    @position(1420, 200)\n    @caption '$Step = empty or $WorkflowContext/Status != TravelApproval.ENUM_RequestStatus.PendingApproval'\n    if $Step = empty or $WorkflowContext/Status != TravelApproval.ENUM_RequestStatus.PendingApproval then\n      @position(1590, 300)\n      show message 'This request was already decided. Nothing was changed.' type Warning;\n      @position(1750, 300)\n      close page;\n      @position(1910, 300)\n      return;\n    end if;\n    @position(1590, 200)\n    change $Step (Comment = trim($DecisionDraft/Text));\n    @position(1750, 200)\n    commit $Step;\n    @position(1910, 200)\n    change $Task (System.WorkflowUserTask_Assignees = [%CurrentUser%]);\n    @position(2070, 200)\n    commit $Task;\n    @position(2230, 200)\n    @merge(2520, 200)\n    @caption '$DecisionDraft/Mode = TravelApproval.ENUM_DecisionMode.RejectRequest'\n    if $DecisionDraft/Mode = TravelApproval.ENUM_DecisionMode.RejectRequest then\n      @position(2400, 200)\n      set task outcome $Task 'Reject';\n    else\n      @position(2400, 300)\n      set task outcome $Task 'Return';\n    end if;\n    @position(2640, 200)\n    close page;\n    @position(2800, 200)\n    show page TravelApproval.Approvals_Inbox;\n    @position(2960, 200)\n    return;\n  end if;\nend;\n\ngrant execute on microflow TravelApproval.ACT_Decision_Confirm to TravelApproval.Approver;\n/","sourceMap":{"node-048a0de4-3213-4ef3-80ef-3f39d289daad":{"startLine":40,"endLine":41},"node-05c1abca-c0ae-4130-a559-207c701e1bff":{"startLine":38,"endLine":39},"node-0da47d81-66d4-4005-8357-df6aadb40810":{"startLine":30,"endLine":31},"node-0f73002d-4d3f-4984-8886-a738c726d53c":{"startLine":19,"endLine":20},"node-1e8ef59b-fafc-4285-8c4b-b49e86b770e2":{"startLine":53,"endLine":62},"node-28496d5d-1616-45ce-aa79-32039c1edecc":{"startLine":16,"endLine":17},"node-3a2ea504-69a5-404b-b4a8-4b50fea47150":{"startLine":28,"endLine":29},"node-3dc71b94-ebd3-4612-a1a7-b151341f6b50":{"startLine":60,"endLine":61},"node-43cddb97-6e32-4a02-b4a4-9014153c8096":{"startLine":25,"endLine":32},"node-461ddf73-f058-4730-8c8a-521f6357c8b0":{"startLine":51,"endLine":52},"node-49973c04-3889-4d82-bcfc-93ea9b149efa":{"startLine":49,"endLine":50},"node-6d24ec14-ca03-4b6a-b838-4e770aecd39b":{"startLine":9,"endLine":69},"node-74433b63-1a80-49de-8a47-0276c916eec4":{"startLine":47,"endLine":48},"node-884a170a-2762-48da-9142-9a73cf53cf81":{"startLine":65,"endLine":66},"node-a00fb800-689b-4be4-b6ee-722474bf1f8b":{"startLine":42,"endLine":43},"node-cbb222b1-9ec7-414e-ac35-ee9df9b72a89":{"startLine":45,"endLine":46},"node-d76871d0-5e45-4c70-8e0b-bbf144acda5b":{"startLine":12,"endLine":21},"node-d8f0c06e-3702-4069-8975-e60d96fd6e50":{"startLine":35,"endLine":44},"node-db4754f0-0774-48d9-89e5-b972f7faa37e":{"startLine":33,"endLine":34},"node-e419ffdc-40c0-4f10-bbd0-6df30662bb2b":{"startLine":67,"endLine":68},"node-ece0757d-bfc2-4dc9-8221-d369