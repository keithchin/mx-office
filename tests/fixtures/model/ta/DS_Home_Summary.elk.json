},{"id":"edge-1","sourceId":"node-4c8c95df-9cfa-45a0-b338-4687281cc9da","targetId":"node-fd56ed1a-df4b-407f-8592-44e8e7f5d8e4"},{"id":"edge-2","sourceId":"node-fd56ed1a-df4b-407f-8592-44e8e7f5d8e4","targetId":"node-0aedb8cc-00a2-43a9-8284-849c839af793"},{"id":"edge-3","sourceId":"node-0aedb8cc-00a2-43a9-8284-849c839af793","targetId":"node-017651a2-c1f2-465e-9076-96babe439e79"},{"id":"edge-4","sourceId":"node-017651a2-c1f2-465e-9076-96babe439e79","targetId":"node-8b60872a-9e55-4a13-acc7-dfaeec5f19f7"},{"id":"edge-5","sourceId":"node-8b60872a-9e55-4a13-acc7-dfaeec5f19f7","targetId":"node-1a03920d-8c4d-4275-be15-6eed9b0f4a35"},{"id":"edge-6","sourceId":"node-1a03920d-8c4d-4275-be15-6eed9b0f4a35","targetId":"node-b2df14eb-3292-43d2-9d1d-1908d3e9751f"},{"id":"edge-7","sourceId":"node-b2df14eb-3292-43d2-9d1d-1908d3e9751f","targetId":"node-9caa5a9b-1441-4e82-8e62-75e1369fe058"},{"id":"edge-8","sourceId":"node-682ffb5b-692a-48f4-8737-7860146c751a","targetId":"node-9be0b4be-e6bc-480e-8eb6-561e68a889e0","label":"false"},{"id":"edge-9","sourceId":"node-682ffb5b-692a-48f4-8737-7860146c751a","targetId":"node-07bc060b-458a-47ad-abbf-974a6884e02a","label":"true"},{"id":"edge-10","sourceId":"node-07bc060b-458a-47ad-abbf-974a6884e02a","targetId":"node-9be0b4be-e6bc-480e-8eb6-561e68a889e0"},{"id":"edge-11","sourceId":"node-9caa5a9b-1441-4e82-8e62-75e1369fe058","targetId":"node-682ffb5b-692a-48f4-8737-7860146c751a"},{"id":"edge-12","sourceId":"node-6fe4e776-56a6-43ab-aba9-244e9d0852b3","targetId":"node-5cc6bd23-13ed-4baa-97a3-17f21e8882ef","label":"false"},{"id":"edge-13","sourceId":"node-6fe4e776-56a6-43ab-aba9-244e9d0852b3","targetId":"node-038bd829-7935-47f4-ac36-603005cbf623","label":"true"},{"id":"edge-14","sourceId":"node-038bd829-7935-47f4-ac36-603005cbf623","targetId":"node-5cc6bd23-13ed-4baa-97a3-17f21e8882ef"},{"id":"edge-15","sourceId":"node-9be0b4be-e6bc-480e-8eb6-561e68a889e0","targetId":"node-6fe4e776-56a6-43ab-aba9-244e9d0852b3"},{"id":"edge-16","sourceId":"node-5cc6bd23-13ed-4baa-97a3-17f21e8882ef","targetId":"node-4e6a9faa-e39e-4229-bd89-e2e06d109447"}],"mdlSource":"/**\n * Data source of Home (build-plan row 42). For my action = requests whose OPEN step the signed-in person holds (PendingApproval, step Pending and activated) plus their own requests returned to them. IsManager from SUB_TravelProfile_IsManager (PD-2) drives the My team card; IsFinance (holds the Finance user role) drives the All requests card. Team and Finance numbers are only computed when the flag is true.\n */\ncreate or modify microflow TravelApproval.DS_Home_Summary ()\nreturns TravelApproval.HomeSummary as $Summary\nbegin\n  @position(360, 200)\n  declare $LoginName String = if $currentUser = empty then '' else $currentUser/Name;\n  @position(520, 200)\n  retrieve $ToApprove from TravelApproval.TravelRequest\n    where Status = TravelApproval.ENUM_RequestStatus.PendingApproval and TravelApproval.ApprovalStep_TravelRequest/TravelApproval.ApprovalStep[Decision = 'Pending' and ActivatedOn != empty]/TravelApproval.ApprovalStep_Approver/TravelApproval.TravelProfile/TravelApproval.TravelProfile_Account/Administration.Account/Name = $LoginName;\n  @position(680, 200)\n  $ToApproveCount = count($ToApprove);\n  @position(840, 200)\n  retrieve $ReturnedToMe from TravelApproval.TravelRequest\n    where Status = TravelApproval.ENUM_RequestStatus.ReturnedToRequestor and TravelApproval.TravelRequest_Requestor/TravelApproval.TravelProfile/TravelApproval.TravelProfile_Account/Administration.Account/Name = $LoginName;\n  @position(1000, 200)\n  $ReturnedToMeCount = count($ReturnedToMe);\n  @position(1160, 200)\n  $IsManager = call microflow TravelApproval.SUB_TravelProfile_IsManager();\n  @position(1320, 200)\n  retrieve $FinanceRole from System.UserRole\n    where Name = 'Finance' and System.UserRoles/System.User/Name = $LoginName\n    limit 1;\n  @position(1480, 200)\n  $Summary = create TravelApproval.HomeSummary (ToApproveCount = $ToApproveCount, ReturnedToMeCount = $ReturnedToMeCount, ForActionCount = $ToApproveCount + $ReturnedToMeCount, IsManager = $IsManager, IsFinance = $FinanceRole != empty);\n  @position(1640, 200)\n  @merge(1930, 200)\n  @caption '$IsManager'\n  if $IsManager then\n    @position(1810, 300)\n    call microflow TravelApproval.SUB_HomeSummary_Team(Summary = $Summary, LoginName = $LoginName);\n  end if;\n  @position(2050, 200)\n  @merge(2340, 200)\n  @caption '$FinanceRole != empty'\n  if $FinanceRole != empty then\n    @position(2220, 300)\n    call microflow TravelApproval.SUB_HomeSummary_Finance(Summary = $Summary);\n  end if;\n  @position(2460, 200)\n  return $Summary;\nend;\n\ngrant execute on microflow TravelApproval.DS_Home_Summary to TravelApproval.Requestor, TravelApproval.Approver, TravelApproval.Finance;\n/","sourceMap":{"node-017651a2-c1f2-465e-9076-96babe439e79":{"startLine":12,"endLine":13},"node-038bd829-7935-47f4-ac36-603005cbf623":{"startLine":33,"endLine":34},"node-07bc060b-458a-47ad-abbf-974a6884e02a":{"startLine":26,"endLine":27},"node-0aedb8cc-00a2-43a9-8284-849c839af793":{"startLine":10,"endLine":11},"node-1a03920d-8c4d-4275-be15-6eed9b0f4a35":{"startLine":16,"endLine":17},"node-4c8c95df-9cfa-45a0-b338-4687281cc9da":{"startLine":6,"endLine":7},"node-4e6a9faa-e39e-4229-bd89-e2e06d109447":{"startLine":36,"endLine":37},"node-682ffb5b-692a-48f4-8737-7860146c751a":{"startLine":22,"endLine":28},"node-6fe4e776-56a6-43ab-aba9-244e9d0852b3":{"startLine":29,"endLine":35},"node-8b60872a-9e55-4a13-acc7-dfaeec5f19f7":{"startLine":14,"endLine":15},"node-9caa5a9b-1441-4e82-8e62-75e1369fe058":{"startLine":20,"endLine":21},"node-b2df14eb-3292-43d2-9d1d-1908d3e9751f":{"startLine":18,"endLine":19},"node-fd56ed1a-df4b-407f-8592-44e8e7f5d8e4":{"startLine":8,"endLine":9}}}