e-29","sourceId":"node-68bcaf2c-ea04-4fa1-886a-1166193d765c","targetId":"node-c7905219-b9dd-44d7-9b60-edcc43a6e5cc"},{"id":"edge-30","sourceId":"node-fcb5cd25-7595-484b-92d0-7f1fc9640131","targetId":"node-553ba9e8-5109-44ae-acf4-95918c8fb035","label":"false"},{"id":"edge-31","sourceId":"node-553ba9e8-5109-44ae-acf4-95918c8fb035","targetId":"node-146cbd4f-0423-45d8-bfb4-dbfa88b5ba08"},{"id":"edge-32","sourceId":"node-146cbd4f-0423-45d8-bfb4-dbfa88b5ba08","targetId":"node-0b43c650-2c5c-4850-a236-70beeffd94bc"},{"id":"edge-33","sourceId":"node-4f96634d-d7de-437b-9580-61bfb7d44dc9","targetId":"node-0e356874-b832-4ba7-9a3c-5209652ae7d2","label":"false"},{"id":"edge-34","sourceId":"node-4f96634d-d7de-437b-9580-61bfb7d44dc9","targetId":"node-14192f61-976a-43a1-8f8b-5774a8db05c5","label":"true"},{"id":"edge-35","sourceId":"node-14192f61-976a-43a1-8f8b-5774a8db05c5","targetId":"node-a37efaa6-03db-40d5-b98c-91618bf07fae"},{"id":"edge-36","sourceId":"node-a37efaa6-03db-40d5-b98c-91618bf07fae","targetId":"node-0e356874-b832-4ba7-9a3c-5209652ae7d2"},{"id":"edge-37","sourceId":"node-0b43c650-2c5c-4850-a236-70beeffd94bc","targetId":"node-4f96634d-d7de-437b-9580-61bfb7d44dc9"},{"id":"edge-38","sourceId":"node-0e356874-b832-4ba7-9a3c-5209652ae7d2","targetId":"node-c7905219-b9dd-44d7-9b60-edcc43a6e5cc"},{"id":"edge-39","sourceId":"node-e6009cfb-68fa-4c4f-8174-9766140c61c1","targetId":"node-fcb5cd25-7595-484b-92d0-7f1fc9640131"},{"id":"edge-40","sourceId":"node-c7905219-b9dd-44d7-9b60-edcc43a6e5cc","targetId":"node-46241d4e-4bc8-46cf-ad80-4d4b2e516ac3"},{"id":"edge-41","sourceId":"node-2af9e8ff-6e7b-4b66-98d9-81916645d9a5","targetId":"node-3f5c7af2-b116-40a7-88cc-6941d4974fc0"},{"id":"edge-42","sourceId":"node-46241d4e-4bc8-46cf-ad80-4d4b2e516ac3","targetId":"node-717206db-23dd-4dad-84f0-033f48ae4954"}],"mdlSource":"/**\n * Before-commit handler of Responsibility (architect decision, DA01): at most one row per Level and Country, and for Manager rows at most one per Subject. Also requires an approver, a subject on Manager rows and a country on the other levels. A row is never counted against itself (an edit of an existing row passes). Returns false to stop the commit; the feedback lands on the field.\n */\ncreate or modify microflow TravelApproval.VAL_Responsibility (\n  $Responsibility: TravelApproval.Responsibility\n)\nreturns Boolean as $IsValid\nbegin\n  @position(360, 200)\n  declare $IsValid Boolean = true;\n  @position(520, 200)\n  retrieve $Approver from $Responsibility/TravelApproval.Responsibility_Approver;\n  @position(680, 200)\n  @merge(1130, 200)\n  @caption '$Approver = empty'\n  if $Approver = empty then\n    @position(850, 300)\n    validation feedback $Responsibility/TravelApproval.Responsibility_Approver message 'An approver is required.';\n    @position(1010, 300)\n    set $IsValid = false;\n  end if;\n  @position(1250, 200)\n  @caption '$Responsibility/Level = empty'\n  if $Responsibility/Level = empty then\n    @position(1420, 300)\n    validation feedback $Responsibility/Level message 'Level is required.';\n    @position(1580, 300)\n    return false;\n  end if;\n  @position(1420, 200)\n  declare $RowLevel enum TravelApproval.ENUM_ApprovalLevel = $Responsibility/Level;\n  @position(1675, 200)\n  @merge(3215, 200)\n  @caption '$RowLevel = TravelApproval.ENUM_ApprovalLevel.Manager'\n  if $RowLevel = TravelApproval.ENUM_ApprovalLevel.Manager then\n    @position(1845, 200)\n    retrieve $Subject from $Responsibility/TravelApproval.Responsibility_Subject;\n    @position(2005, 200)\n    @merge(3160, 200)\n    @caption '$Subject = empty'\n    if $Subject = empty then\n      @position(2175, 200)\n      validation feedback $Responsibility/TravelApproval.Responsibility_Subject message 'A Manager row needs the person it is for.';\n      @position(2335, 200)\n      set $IsValid = false;\n    else\n      @position(2175, 350)\n      retrieve $SubjectRows from TravelApproval.Responsibility\n    where Level = TravelApproval.ENUM_ApprovalLevel.Manager and TravelApproval.Responsibility_Subject = $Subject;\n      @position(2335, 350)\n      $SubjectCount = count($SubjectRows);\n      @position(2495, 350)\n      $SubjectIsSelf = contains($SubjectRows, $Responsibility);\n      @position(2655, 350)\n      @merge(3105, 350)\n      @caption '$SubjectCount > 1 or ($SubjectCount = 1 and not($SubjectIsSelf))'\n      if $SubjectCount > 1 or ($SubjectCount = 1 and not($SubjectIsSelf)) then\n        @position(2825, 450)\n        validation feedback $Responsibility/Level message 'This person already has a Manager row.';\n        @position(2985, 450)\n        set $IsValid = false;\n      end if;\n    end if;\n  else\n    @position(1845, 500)\n    retrieve $Country from $Responsibility/TravelApproval.Responsibility_Country;\n    @position(2005, 500)\n    @merge(3160, 500)\n    @caption '$Country = empty'\n    if $Country = empty then\n      @position(2175, 500)\n      validation feedback $Responsibility/TravelApproval.Responsibility_Country message 'A country is required for this level.';\n      @position(2335, 500)\n      set $IsValid = false;\n    else\n      @position(2175, 650)\n      retrieve $CountryRows from TravelApproval.Responsibility\n    where Level = $RowLevel and TravelApproval.Responsibility_Country = $Country;\n      @position(2335, 650)\n      $CountryCount = count($CountryRows);\n      @position(2495, 650)\n      $CountryIsSelf = contains($CountryRows, $Responsibility);\n      @position(2655, 650)\n      @merge(3105, 650)\n      @caption '$CountryCount > 1 or ($CountryCount = 1 and not($CountryIsSelf))'\n      if $CountryCount > 1 or ($CountryCount = 1 and not($CountryIsSelf)) then\n        @position(2825, 750)\n        validation feedback $Responsibility/Level message 'This level already has a row for this country.';\n        @position(2985, 750)\n        set $IsValid = false;\n      end if;\n    end if;\n  end if;\n  @position(3335, 200)\n  return $IsValid;\nend;\n/","sourceMap":{"node-011e1f75-56ae-475b-92de-7970e83f1ab0":{"startLine":52,"endLine":60},"node-0b43c650-2c5c-4850-a236-70beeffd94bc":{"startLine":78,"endLine":79},"node-0b761f8e-7894-4119-ab93-b966892498cb":{"startLine":35,"endLine":36},"node-0e97b9ed-3489-4df4-b8c6-3eac2b79a61b":{"startLine":43,"endLine":44},"node-14192f61-976a-43a1-8f8b-5774a8db05c5":{"startLine":84,"endLine":85},"node-146cbd4f-0423-45d8-bfb4-dbfa88b5ba08":{"startLine":76,"endLine":77},"node-1703fc1d-a8ac-4a84-8e65-a281df4f668c":{"startLine":46,"endLine":47},"node-2af9e8ff-6e7b-4b66-98d9-81916645d9a5":{"startLine":29,"endLine":30},"node-3075b361-d6f3-4272-8674-a6189f7b29ce":{"startLine":69,"endLine":70},"node-325ce426-f753-4862-88e4-9662c9736fc7":{"startLine":37,"endLine":61},"node-3267306c-70a1-4240-953e-9c3661fc490d":{"startLine":58,"endLine":59},"node-3f5c7af2-b116-40a7-88cc-6941d4974fc0":{"startLine":31,"endLine":90},"node-4f96634d-d7de-437b-9580-61bfb7d44dc9":{"startLine":80,"endLine":88},"node-553ba9e8-5109-44ae-acf4-95918c8fb035":{"startLine":74,"endLine":75},"node-5d63edf8-b5f0-4ddd-943e-1b4673a0600d":{"startLine":24,"endLine":25},"node-68bcaf2c-ea04-4fa1-886a-1166193d765c":{"startLine":71,"endLine":72},"node-6f99e2f7-4ec9-4ced-bd9c-996f56d18aec":{"startLine":8,"endLine":9},"node-717206db-23dd-4dad-84f0-033f48ae4954":{"startLine":91,"endLine":92},"node-7e669f6c-343f-48b0-91b7-6a45e64a556e":{"startLine":21,"endLine":28},"node-8a876013-59f9-48c7-8412-d522c8be86d6":{"startLine":56,"endLine":57},"node-8e294a00-72a4-4d43-8518-9180a50cb616":{"startLine":16,"endLine":17},"node-a37efaa6-03db-40d5-b98c-91618bf07fae":{"startLine":86,"endLine":87},"node-a408765f-7f55-44d5-b89b-25e7d97e9a78":{"startLine":10,"endLine":11},"node-adb4dcf1-29d1-4af3-ae79-8e2380c58b4c":{"startLine":12,"endLine":20},"node-bb84a605-ab52-4081-85bf-63cb67520d65":{"startLine":41,"endLine":42},"node-d0549b57-efae-40d0-a261-da19dbcc5f0e":{"startLine":50,"endLine":51},"node-d9eb399b-29ce-4722-aaaa-1560a89c9d36":{"startLine":18,"endLine":19},"node-e6009cfb-68fa-4c