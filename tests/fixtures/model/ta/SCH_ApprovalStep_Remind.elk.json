{"format":"elk","type":"microflow","name":"TravelApproval.SCH_ApprovalStep_Remind","parameters":null,"returnType":"Void","nodes":[{"id":"node-f0b79516-8549-4a66-8495-57a49318f205","type":"start","category":"event","label":"Start","width":85.5,"height":36},{"id":"node-e19d8e82-71c2-4bf1-8133-677e549a40a5","type":"action","category":"variable","label":"declare $Now","details":["Variable: $Now","Value: [%CurrentDateTime%]"],"width":219,"height":60},{"id":"node-fe31d32d-9f68-404d-8a7f-5d61472d6194","type":"action","category":"variable","label":"declare $BatchSize","details":["Variable: $BatchSize","Value: @TravelApproval.REMINDER_BATCH_SIZE"],"width":339,"height":60},{"id":"node-ede392d5-0659-44ac-8213-48ecc1af0045","type":"action","category":"variable","label":"declare $Cutoff","details":["Variable: $Cutoff","Value: addDays(trimToDays($Now), 1 - @TravelApproval.REMINDER_IN..."],"width":527,"height":60},{"id":"node-75d1b49c-27c9-42d6-b015-2c3deff4927f","type":"action","category":"retrieve","label":"Retrieve TravelApproval.ApprovalStep","details":["Output: $Steps","From: TravelApproval.ApprovalStep","Where: [\n  Decision = 'Pending'\n  and ActivatedOn != empty\n  and...","Range: Custom limit=$BatchSize","Sort: TravelApproval.ApprovalStep.ActivatedOn Ascending"],"width":527,"height":108},{"id":"node-fe71948e-4b4a-4094-b5a5-56209f20ea9b","type":"action","category":"variable","label":"Action","width":100,"height":36},{"id":"node-86b8aefa-9f5f-4fe8-a012-f44f338af897","type":"loop","category":"loop","label":"Loop","details":["List: $Steps","Iterator: $Step"],"width":0,"height":0,"children":[{"id":"node-49e25e12-b9a2-4a7c-8a2c-0b280ea343ec","type":"action","category":"call","label":"Call TravelApproval.SUB_Approval...","details":["Microflow: TravelApproval.SUB_ApprovalStep_RemindOne","ApprovalStep = $Step","Now = $Now","Result: $Reminded"],"width":414,"height":92},{"id":"node-00cd6b1e-a2e6-462d-b87d-76ae71082f42","type":"split","category":"controlflow","label":"$Reminded","details":["Caption: $Reminded","Condition: $Reminded"],"width":115.5,"height":60},{"id":"node-414fc43f-bfa6-41e8-a173-29fd99055f2e","type":"merge","category":"controlflow","label":"Activity","width":24,"height":24},{"id":"node-4a0817c6-0e51-46b3-9d3d-8429c6b2f808","type":"action","category":"variable","label":"Action","width":100,"height":36}]},{"id":"node-533e53e1-aaab-45a6-9aeb-182866e40233","type":"action","category":"object","label":"commit $Step_CommitList","details":["Variable: $Step_CommitList","With events: true"],"width":219,"height":60},{"id":"node-0dd0f135-51ef-4606-bc80-0e78c9698512","type":"action","category":"variable","label":"Aggregate $ReminderCount","details":["List: $Step_CommitList","Function: Count","Output: $ReminderCount"],"width":204,"height":76},{"id":"node-3f813f1b-5d35-4d62-9193-0521ac56fa56","type":"action","category":"variable","label":"Aggregate $CandidateCount","details":["List: $Steps","Function: Count","Output: $CandidateCount"],"width":212,"height":76},{"id":"node-095cfcb8-2e51-49ba-8762-fe8ffaab9221","type":"action","category":"log","label":"Log Message","details":["Level: Info","Node: 'TravelApproval'","Message: Reminder run: {1} reminder(s) sent, {2} candidate step(s)"],"width":519,"height":76},{"id":"node-fdf34861-ab59-44c7-b681-aef48275c6ca","type":"end","category":"event","label":"End","width":70.5,"height":36}],"edges":[{"id":"edge-0","sourceId":"node-f0b79516-8549-4a66-8495-57a49318f205","targetId":"node-e19d8e82-71c2-4bf1-8133-677e549a40a5"},{"id":"edge-1","sourceId":"node-e19d8e82-71c2-4bf1-8133-677e549a40a5","targetId":"node-fe31d32d-9f68-404d-8a7f-5d61472d6194"},{"id":"edge-2","sourceId":"node-fe31d32d-9f68-404d-8a7f-5d61472d6194","targetId":"node-ede392d5-0659-44ac-8213-48ecc1af0045"},{"id":"edge-3","sourceId":"node-ede392d5-0659-44ac-8213-48ecc1af0045","targetId":"node-75d1b49c-27c9-42d6-b015-2c3deff4927f"},{"id":"edge-4","sourceId":"node-75d1b49c-27c9-42d6-b015-2c3deff4927f","targetId":"node-fe71948e-4b4a-4094-b5a5-56209f20ea9b"},{"id":"edge-5","sourceId":"node-00cd6b1e-a2e6-462d-b87d-76ae71082f42","targetId":"node-414fc43f-bfa6-41e8-a173-29fd99055f2e","label":"false"},{"id":"edge-6","sourceId":"node-00cd6b1e-a2e6-462d-b87d-76ae71082f42","targetId":"node-4a0817c6-0e51-46b3-9d3d-8429c6b2f808","label":"true"},{"id":"edge-7","sourceId":"node-4a0817c6-0e51-46b3-9d3d-8429c6b2f808","targetId":"node-414fc43f-bfa6-41e8-a173-29fd99055f2e"},{"id":"edge-8","sourceId":"node-49e25e12-b9a2-4a7c-8a2c-0b280ea343ec","targetId":"node-00cd6b1e-a2e6-462d-b87d-76ae71082f42"},{"id":"edge-9","sourceId":"node-fe71948e-4b4a-4094-b5a5-56209f20ea9b","targetId":"node-86b8aefa-9f5f-4fe8-a012-f44f338af897"},{"id":"edge-10","sourceId":"node-86b8aefa-9f5f-4fe8-a012-f44f338af897","targetId":"node-533e53e1-aaab-45a6-9aeb-182866e40233"},{"id":"edge-11","sourceId":"node-533e53e1-aaab-45a6-9aeb-182866e40233","targetId":"node-0dd0f135-51ef-4606-bc80-0e78c9698512"},{"id":"edge-12","sourceId":"node-0dd0f135-51ef-4606-bc80-0e78c9698512","targetId":"node-3f813f1b-5d35-4d62-9193-0521ac56fa56"},{"id":"edge-13","sourceId":"node-3f813f1b-5d35-4d62-9193-0521ac56fa56","targetId":"node-095cfcb8-2e51-49ba-8762-fe8ffaab9221"},{"id":"edge-14","sourceId":"node-095cfcb8-2e51-49ba-8762-fe8ffaab9221","targetId":"node-fdf34861-ab59-44c7-b681-aef48275c6ca"}],"mdlSource":"/**\n * Scheduled daily (SE_ApprovalStep_Remind). Retrieves at most REMINDER_BATCH_SIZE activated Pending steps on PendingApproval requests (never ReturnedToRequestor) whose ActivatedOn and LastRemindedOn are both older than the calendar pre-filter, oldest first; SUB_ApprovalStep_RemindOne decides per step by working days (REMINDER_INTERVAL_WORKING_DAYS) and sends; the reminded steps are committed once, after the loop (batch commit, no commit in the loop). Steps beyond the batch are picked up by the next run.\n */\ncreate or modify microflow TravelApproval.SCH_ApprovalStep_Remind ()\nbegin\n  @position(360, 200)\n  declare $Now DateTime = [%CurrentDateTime%];\n  @position(520, 200)\n  declare $BatchSize Integer = @TravelApproval.REMINDER_BATCH_SIZE;\n  @position(680, 200)\n  declare $Cutoff DateTime = addDays(trimToDays($Now), 1 - @TravelApproval.REMINDER_INTERVAL_WORKING_DAYS);\n  @position(840, 200)\n  retrieve $Steps from TravelApproval.ApprovalStep\n    where Decision = TravelApproval.ENUM_StepDecision.Pending and ActivatedOn != empty and ActivatedOn < $Cutoff and (LastRemindedOn = empty or LastRemindedOn < $Cutoff) and TravelApproval.ApprovalStep_TravelRequest/TravelApproval.TravelRequest/Status = 'PendingApproval'\n    sort by TravelApproval.ApprovalStep.ActivatedOn asc\n    limit $BatchSize;\n  @position(1000, 200)\n  $Step_CommitList = create list of TravelApproval.ApprovalStep;\n  @position(1465, 200)\n  @anchor(from: right, to: left)\n  loop $Step in $Steps\n  begin\n    @position(210, 130)\n    $Reminded = call microflow TravelApproval.SUB_ApprovalStep_RemindOne(ApprovalStep = $Step, Now = $Now);\n    @position(370, 130)\n    @merge(660, 130)\n    @caption '$Reminded'\n    if $Reminded then\n      @position(540, 230)\n      add $Step to $Step_CommitList;\n    end if;\n  end loop;\n  @position(1930, 200)\n  commit $Step_CommitList;\n  @position(2090, 200)\n  $ReminderCount = count($Step_CommitList);\n  @position(2250, 200)\n  $CandidateCount = count($Steps);\n  @position(2410, 200)\n  log info node 'TravelApproval' 'Reminder run: {1} reminder(s) sent, {2} candidate step(s)' with ({1} = toString($ReminderCount), {2} = toString($CandidateCount));\n  @position(2650, 200)\n  return;\nend;\n/","sourceMap":{"node-00cd6b1e-a2e6-462d-b87d-76ae71082f42":{"startLine":21,"endLine":27},"node-095cfcb8-2e51-49ba-8762-fe8ffaab9221":{"startLine":35,"endLine":36},"node-0dd0f135-51ef-4606-bc80-0e78c9698512":{"startLine":31,"endLine":32},"node-3f813f1b-5d35-4d62-9193-0521ac56fa56":{"startLine":33,"endLine":34},"node-49e25e12-b9a2-4a7c-8a2c-0b280ea343ec":{"startLine":19,"endLine":20},"node-4a0817c6-0e51-46b3-9d3d-8429c6b2f808":{"startLine":25,"endLine":26},"node-533e53e1-aaab-45a6-9aeb-182866e40233":{"startLine":29,"endLine":30},"node-75d1b49c-27c9-42d6-b015-2c3deff4927f":{"startLine":11,"endLine":12},"node-86b8aefa-9f5f-4fe8-a012-f44f338af897":{"startLine":15,"endLine":28},"node-e19d8e82-71c2-4bf1-8133-677e549a40a5":{"startLine":5,"endLine":6},"node-ede392d5-0659-44ac-8213-48ecc1af0045":{"startLine":9,"endLine":10},"node-fdf34861-ab59-44c7-b681-aef48275c6ca":{"startLine":37,"endLine":38},"node-fe31d32d-9f68-404d-8a7f-5d61472d6194":{"startLine":7,"endLine":8},"node-fe71948e-4b4a-4094-b5a5-56209f20ea9b":{"startLine":13,"endLine":14}}}